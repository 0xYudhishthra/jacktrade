PORT=8787
# Public base URL of this server (used to build the MCP URL users paste into Grok)
PUBLIC_URL=http://localhost:8787
# Web app base URL (used for "Make it real" links)
WEB_URL=http://localhost:5173
# 32+ random bytes, hex. Encrypts agent keys at rest. `openssl rand -hex 32`
SERVER_SECRET=
DB_PATH=./data/connector.db

RELAYER_URL=https://jt-relayer-production.up.railway.app
PRICES_URL=https://jt-prices-production.up.railway.app
INDEXER_URL=https://jt-indexer-production.up.railway.app
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Robinhood Chain block explorer base URL (optional; tx hashes are shown bare if empty)
EXPLORER_URL=

# Definitive Flash (kept server-side, proxied for the web app)
FLASH_API_KEY=

# JackTradePoints on Robinhood Chain (optional). The syncer key credits points onchain every minute.
POINTS_ADDRESS=
POINTS_SYNCER_KEY=
