# Red: mainnet (Robinhood Chain 4663) o fork (anvil local que copia mainnet)
NETWORK=mainnet

# RPC de Robinhood Chain (público, con límite de pedidos)
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# RPC del fork local
FORK_RPC_URL=http://127.0.0.1:8545

# Segundos entre bloques del fork (mainnet hace ~0,1 s)
FORK_BLOCK_TIME=0.2

# Precios de Pyth (Hermes). La clave va en el header Authorization: Bearer
HERMES_URL=https://pyth.dourolabs.app/hermes
HERMES_API_KEY=

# Segundos sin precio nuevo antes de avisar
PRICE_STALE_SECONDS=5

# Puerto del websocket de precios para el front (el front usa 8086)
PRICES_PORT=8090

# Relayer
RELAYER_PORT=8091
# Segundos máximos desde signedAt (el contrato acepta hasta intentTtl = 1 h)
RELAYER_MAX_INTENT_AGE=30
# Segundos que signedAt puede ir adelantado respecto de la cadena (default 2; en el fork 15)
# RELAYER_FUTURE_TOLERANCE=2
# Batch: cada cuántos ms, cuántos intents como máximo y cuánto espera un intent un precio posterior a su firma
RELAYER_BATCH_MS=200
RELAYER_MAX_BATCH=50
# RELAYER_PRICE_WAIT_MS=5000 (default 5000; en el fork 20000)
# Clave del relayer (solo mainnet; en el fork usa la cuenta 1 de anvil). Nunca en el repo.
# RELAYER_PRIVATE_KEY=

# Solo fork: maxConfBps de los mercados en setup:fork (main usa 10). Subirlo evita rechazos por confianza en pruebas.
# FORK_MAX_CONF_BPS=25

# Solo fork: flags extra para anvil (por ejemplo --no-rate-limit)
# FORK_ANVIL_ARGS=

# Historial de velas (Pyth) y segundos de caché
# PYTH_HISTORY_URL=https://pyth.dourolabs.app/v1/fixed_rate@1000ms/history
# Clave aparte para /history (si no está, usa HERMES_API_KEY): si alguien abusa del historial, los precios siguen
# PYTH_HISTORY_API_KEY=
# Tope global de pedidos a Pyth desde /history (por segundo y ráfaga), además del límite por IP
# HISTORY_UPSTREAM_PER_SECOND=5
# HISTORY_UPSTREAM_BURST=20
# HISTORY_CACHE_MS=5000

# Liquidador
LIQUIDATOR_PORT=8094
# Desde qué bloque leer eventos en mainnet (si falta, busca el bloque del deploy del Exchange)
# LIQUIDATOR_FROM_BLOCK=
# RPC para eth_getLogs en mainnet (Alchemy gratis solo deja 10 bloques) y bloques por consulta
# LOGS_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# LOGS_CHUNK=5000

# Liquidador: clave (solo mainnet; en el fork usa la cuenta 5 de anvil), ids por tx, gas y reintento
# LIQUIDATOR_PRIVATE_KEY=
# LIQUIDATOR_MAX_IDS=100
# LIQUIDATOR_GAS_BASE=200000
# LIQUIDATOR_GAS_PER_LIQUIDATION=300000
# LIQUIDATOR_RETRY_MS=15000
# Solo fork: límite de OI por lado en USD (main usa 250000). Subirlo para la prueba de estrés.
# FORK_OI_CAP=250000
# Relayer: tope de espera del recibo, gas para validar firmas ERC-1271, límite por IP (TRUST_PROXY=1 detrás de un proxy)
# RELAYER_RECEIPT_TIMEOUT_MS=30000
# RELAYER_ERC1271_GAS=150000
# RELAYER_IP_BURST=30
# RELAYER_IP_PER_SECOND=10
# TRUST_PROXY=1
# Liquidador: confirmaciones, gas de updatePrices, pausa después de un error, tope del recibo y ETH mínimo antes de alertar
# LIQUIDATOR_CONFIRMATIONS=2
# LIQUIDATOR_UPDATE_GAS=1000000
# LIQUIDATOR_PAUSE_AFTER_ERROR_MS=5000
# LIQUIDATOR_RECEIPT_TIMEOUT_MS=30000
# LIQUIDATOR_MIN_ETH=0.005
# Servicio de precios: límites del websocket y por IP; clave de Pyth aparte para /history (si falta, usa HERMES_API_KEY)
# PRICES_MAX_CLIENTS=2000
# PRICES_MAX_CLIENTS_PER_IP=20
# PRICES_IP_BURST=30
# PRICES_IP_PER_SECOND=10
# PYTH_HISTORY_API_KEY=
# Alertas: ETH mínimo del relayer y horas sin actividad antes de avisar (el escape hatch se abre a las 24 h)
# RELAYER_MIN_ETH=0.01
# ESCAPE_WARN_SECONDS=72000

# Keepers (heartbeat y harvest)
KEEPERS_PORT=8095
# Clave (solo mainnet; en el fork usa la cuenta 6 de anvil). Tiene que estar en BatchExecutor.isRelayer.
# KEEPER_PRIVATE_KEY=
# Cada cuántos ms revisa la cadena
# KEEPER_CHECK_MS=15000
# Cuántos segundos antes del vencimiento del escape hatch manda heartbeat (como mucho la mitad del plazo)
# KEEPER_HEARTBEAT_MARGIN_SECONDS=14400
# Harvest: mínimo a pagar en USDG (o la próxima entrada entera), entradas por tx y gas
# KEEPER_HARVEST_MIN_USDG=1
# KEEPER_HARVEST_MAX_ENTRIES=50
# KEEPER_HARVEST_GAS_BASE=100000
# KEEPER_HARVEST_GAS_PER_ENTRY=60000
# KEEPER_HEARTBEAT_GAS=150000
# pushStakerFees: se manda al juntar este mínimo en USDG o, si hay algo, cada estas horas
# KEEPER_STAKER_FEES_MIN_USDG=5
# KEEPER_STAKER_FEES_EVERY_HOURS=24
# KEEPER_STAKER_FEES_GAS=250000
# Alertas: ETH mínimo y minutos de fila con caja sin cobrar (en segundos)
# KEEPER_MIN_ETH=0.002
# KEEPER_HARVEST_STUCK_SECONDS=300

# Indexer (Ponder). Sin DATABASE_URL usa PGlite en indexer/.ponder/
INDEXER_PORT=8096
# DATABASE_URL=postgres://...
# DATABASE_SCHEMA=jacktrade
# INDEXER_FROM_BLOCK=
# Log del indexer (warn por defecto; info muestra cada bloque) y límite por IP de la API
# INDEXER_LOG_LEVEL=warn
# API_IP_BURST=60
# API_IP_PER_SECOND=20

# Alertas por Telegram (sin token y chat no se manda nada). Ver docs/deploy-railway.md
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Segundos que tiene que durar un problema antes de avisar, y minutos entre recordatorios
# ALERT_AFTER_SECONDS=60
# ALERT_REPEAT_MINUTES=60

# Respaldos (ver docs/deploy-railway.md, "Si algo se cae")
# RPC_FALLBACK_URLS=https://rpc.mainnet.chain.robinhood.com
# HERMES_FALLBACK_URL=
# HERMES_FALLBACK_API_KEY=
# Keepers: /live del relayer; si no responde, no se manda heartbeat (vía de escape para los usuarios)
# RELAYER_LIVE_URL=https://hmrelayer-production.up.railway.app/live
# Monitor externo (healthchecks.io): URL de ping de este servicio
# HEALTHCHECK_PING_URL=

# Perfiles (indexer/API): usernames por wallet, firmados por la wallet. Guardados en el schema hm_profiles del mismo
# Postgres (DATABASE_URL); sin Postgres, base embebida en indexer/.ponder/profiles-<red>.
# PROFILE_CHALLENGE_TTL_SECONDS=600
# PROFILE_CHANGE_COOLDOWN_HOURS=24
# PROFILE_IP_BURST=10
# PROFILE_IP_PER_SECOND=0.2
# PROFILE_WALLET_BURST=5
# PROFILE_WALLET_PER_SECOND=0.05
# Leaderboard: closed positions an account needs in the window to get a rank
# LEADERBOARD_MIN_TRADES=1
