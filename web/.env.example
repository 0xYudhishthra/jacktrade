# Grok connector (MCP server + REST for this app)
VITE_CONNECTOR_URL=http://localhost:8787
# JackTrade relayer (config, gasless session-key registration)
VITE_RELAYER_URL=https://hmrelayer-production.up.railway.app
# JackTrade indexer (account balances)
VITE_INDEXER_URL=https://hmindexer-production.up.railway.app
# JackTrade prices feed (live PnL in the bets feed)
VITE_PRICES_URL=https://hmprices-production.up.railway.app
# Robinhood Chain JSON-RPC
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Block explorer base URL (no trailing slash). Leave empty to show tx hashes as plain text.
VITE_EXPLORER_URL=
