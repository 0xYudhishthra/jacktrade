# JackTrade services. These values are baked into the Vite build.
VITE_PRICES_URL=https://hmprices-production.up.railway.app
VITE_RELAYER_URL=https://hmrelayer-production.up.railway.app
VITE_API_URL=https://hmindexer-production.up.railway.app
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Trustware SDK key (deposits from other chains). Without it, the option stays hidden.
VITE_TRUSTWARE_API_KEY=
# Reown AppKit project (wallet picker). Without it, the built-in list of browser wallets is used.
VITE_REOWN_PROJECT_ID=
# Block explorer for tx and address links (optional; empty shows hashes as text).
VITE_EXPLORER_URL=
# Grok connector (MCP + REST + Flash proxy). Empty: same origin in production, localhost:8787 in dev.
VITE_CONNECTOR_URL=
